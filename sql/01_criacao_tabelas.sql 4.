-- TABELA USUARIO
CREATE TABLE IF NOT EXISTS public.usuario (
    id_usuario INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome_completo VARCHAR(120) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    senha VARCHAR(255) NOT NULL,
    cpf CHAR(11),
    telefone VARCHAR(20),
    data_nascimento DATE,
    data_cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    rua VARCHAR(120),
    numero VARCHAR(15),
    bairro VARCHAR(80),
    cep VARCHAR(9),
    cidade VARCHAR(80)
);

-- TABELA PERFIL
CREATE TABLE IF NOT EXISTS public.perfil (
    id_perfil INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    id_usuario INT NOT NULL UNIQUE REFERENCES public.usuario(id_usuario),
    biografia TEXT,
    interesses TEXT,
    nome_perfil VARCHAR(80),
    foto VARCHAR(255)
);

-- TABELA MOTO
CREATE TABLE IF NOT EXISTS public.moto (
    id_moto INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    id_usuario INT NOT NULL REFERENCES public.usuario(id_usuario),
    marca VARCHAR(60),
    modelo VARCHAR(80),
    ano SMALLINT,
    cilindrada INT,
    cor VARCHAR(40),
    placa VARCHAR(10)
);

-- TABELA EVENTO
CREATE TABLE IF NOT EXISTS public.evento (
    id_evento INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome_evento VARCHAR(120) NOT NULL,
    descricao TEXT,
    data_evento DATE,
    horario TIME,
    rua VARCHAR(120),
    numero VARCHAR(15),
    bairro VARCHAR(80),
    cep VARCHAR(9),
    cidade VARCHAR(80)
);

-- TABELA PUBLICACAO
CREATE TABLE IF NOT EXISTS public.publicacao (
    id_publicacao INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    id_perfil INT NOT NULL REFERENCES public.perfil(id_perfil),
    titulo VARCHAR(150),
    descricao TEXT,
    foto VARCHAR(255),
    data_publicacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- TABELA PARTICIPACAO
CREATE TABLE IF NOT EXISTS public.participacao (
    id_participacao INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    id_usuario INT NOT NULL REFERENCES public.usuario(id_usuario),
    id_evento INT NOT NULL REFERENCES public.evento(id_evento),
    data_inscricao TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(30),
    limite_participante INT,
    UNIQUE (id_usuario, id_evento)
);

-- TABELA COMENTARIO
CREATE TABLE IF NOT EXISTS public.comentario (
    id_comentario INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    id_usuario INT NOT NULL REFERENCES public.usuario(id_usuario),
    id_publicacao INT NOT NULL REFERENCES public.publicacao(id_publicacao),
    texto TEXT NOT NULL,
    data_comentario TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- TABELA ANUNCIO
CREATE TABLE IF NOT EXISTS public.anuncio (
    id_anuncio INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    id_usuario INT NOT NULL REFERENCES public.usuario(id_usuario),
    id_moto INT NOT NULL REFERENCES public.moto(id_moto),
    preco DECIMAL(10,2),
    status VARCHAR(30),
    data_anuncio TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    descricao_anuncio TEXT
);

-- TABELA TELEFONE_USUARIO
CREATE TABLE IF NOT EXISTS public.telefone_usuario (
    id_telefone INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    id_usuario INT NOT NULL REFERENCES public.usuario(id_usuario),
    telefone VARCHAR(20) NOT NULL
);

-- INDICE PARA ANUNCIOS ATIVOS
CREATE UNIQUE INDEX IF NOT EXISTS uq_anuncio_moto_ativo
ON public.anuncio (id_moto)
WHERE LOWER(status) = 'ativo';
